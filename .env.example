# Backend Server Configuration (Secret - Not exposed to client)
PORT=3001
JWT_SECRET="your-secure-jwt-secret-key"

# Supabase Production Credentials (Read exclusively by backend server)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-key"

# Mode configuration
USE_MOCK_DB=false

# Payment Gateway Configuration (Strictly server-side - Never exposed to browser)
PAYMENT_EMULATOR_ENABLED=true
PAYMENT_PROVIDER="STRIPE"
PAYMENT_CURRENCY="EUR"
STRIPE_PUBLISHABLE_KEY="pk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PAYMENT_EMULATOR_DELAY_MS=350
DOMAIN="http://localhost:3000"
