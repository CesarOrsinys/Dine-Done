# Backend Server Configuration (Secret - Not exposed to client)
PORT=3001
JWT_SECRET="your-secure-jwt-secret-key"

# Supabase Production Credentials (Read exclusively by backend server)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-key"

# Mode configuration
USE_MOCK_DB=false
